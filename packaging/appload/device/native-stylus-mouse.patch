+bool FBController::eventFilter(QObject *watched, QEvent *event) {
+    if(watched != window()) return false;
+    bool useTabletHandler = _tabletHandlerActive;
+    if(event->type() == QEvent::TabletPress || event->type() == QEvent::TabletMove
+            || event->type() == QEvent::TabletRelease) {
+        useTabletHandler = true;
+    } else if(event->type() == QEvent::MouseButtonPress || event->type() == QEvent::MouseMove
+            || event->type() == QEvent::MouseButtonRelease) {
+        const auto *mouse = static_cast<QMouseEvent *>(event);
+        const auto deviceType = mouse->pointingDevice()->type();
+        if((deviceType == QInputDevice::DeviceType::Stylus || deviceType == QInputDevice::DeviceType::Airbrush)
+                && mouse->source() == Qt::MouseEventNotSynthesized)
+            useTabletHandler = false;
+    }
+    // Xochitl feeds its digitizer into handleMouseEvent using a Stylus device.
+    // TapHandler's point is one event behind on that path. Keep its exclusive
+    // grab disabled so the actual QMouseEvent reaches mouseEvent() unchanged.
+    // Genuine Qt tablet events still use the local handler and its pen grabs.
+    if(useTabletHandler != _tabletHandlerActive) {
+        _tabletHandlerActive = useTabletHandler;
+        emit tabletHandlerActiveChanged();
+    }
+    return false;
+}
