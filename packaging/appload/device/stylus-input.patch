+void FBController::releasePen() {
+    if(!penDown) return;
+    penDown = false;
+    if(framebufferID == -1) return;
+    const qtfb::UserInputContents packet {
+        .inputType = INPUT_PEN_RELEASE, .devId = 0,
+        .x = lastPenPosition.x(), .y = lastPenPosition.y(), .d = 0,
+    };
+    qtfb::management::forwardUserInput(framebufferID, packet);
+}
+
+void FBController::penEvent(PenPhase phase, const QPointF &position, qreal pressure) {
+    if(phase != PenPress && phase != PenMove && phase != PenRelease) return;
+    if(phase == PenPress && (penDown || framebufferID == -1 || !_active)) return;
+    if(phase != PenPress && !penDown) return;
+    // An existing stroke may leave the visible image: preserve its coordinates
+    // so client controls cancel a click or drag normally when released outside.
+    const auto mapped = convertPointToQTFBPixels(position, phase != PenPress);
+    if(phase == PenRelease) {
+        // Evdev tablet clients retain the final down position on release.
+        // Send a final move first when lifting also changed the position.
+        if(mapped && *mapped != lastPenPosition)
+            penEvent(PenMove, position, lastPenPressure / qreal(100));
+        releasePen();
+        return;
+    }
+    if(!mapped) return;
+    const int normalizedPressure = std::isfinite(pressure)
+        ? qRound(qBound(qreal(0), pressure, qreal(1)) * 100) : 0;
+    if(phase == PenMove && *mapped == lastPenPosition && normalizedPressure == lastPenPressure) return;
+    lastPenPosition = *mapped;
+    lastPenPressure = normalizedPressure;
+    penDown = true;
+    const qtfb::UserInputContents packet {
+        .inputType = phase == PenPress ? INPUT_PEN_PRESS : INPUT_PEN_UPDATE,
+        .devId = 0, .x = mapped->x(), .y = mapped->y(), .d = normalizedPressure,
+    };
+    qtfb::management::forwardUserInput(framebufferID, packet);
+}
