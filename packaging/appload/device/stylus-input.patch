+import QtQuick
+import net.asivery.Framebuffer 1.0
+
+// QQuickItem has no tablet-event virtual. Capture only the native stylus path;
+// fingers and physical mice keep the existing FBController event delivery.
+TapHandler {
+    id: stylus
+    target: null
+    enabled: parent.active && parent.visible
+    acceptedDevices: PointerDevice.Stylus | PointerDevice.Airbrush
+    acceptedPointerTypes: PointerDevice.Pen | PointerDevice.Eraser
+    acceptedButtons: Qt.LeftButton
+    gesturePolicy: TapHandler.ReleaseWithinBounds
+    longPressThreshold: 0
+    onPressedChanged: {
+        if (pressed) {
+            parent.forceActiveFocus()
+            parent.penEvent(FBController.PenPress, point.position, point.pressure)
+        }
+    }
+    onGrabChanged: function(transition, eventPoint) {
+        if (transition === PointerDevice.UngrabExclusive || transition === PointerDevice.CancelGrabExclusive) {
+            // On cancellation TapHandler.point may still contain the previous
+            // update. Use the actual release point, localized from the scene.
+            const position = parent.mapFromItem(null, eventPoint.scenePosition)
+            parent.penEvent(FBController.PenRelease, position, 0)
+        }
+    }
+    onPointChanged: {
+        if (pressed)
+            parent.penEvent(FBController.PenMove, point.position, point.pressure)
+    }
+}
